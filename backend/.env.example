# Copy this file to backend/.env. Never commit the real .env file.

# Aiven PostgreSQL: copy Service URI, then replace postgres:// with postgresql+psycopg://
VISION_AI_DATABASE_URL=postgresql+psycopg://avnadmin:PASTE_URL_ENCODED_PASSWORD@YOUR_AIVEN_HOST:15522/defaultdb?sslmode=require

# Cloudinary dashboard -> API Keys -> copy the CLOUDINARY_URL value.
VISION_AI_CLOUDINARY_URL=cloudinary://PASTE_API_KEY:PASTE_API_SECRET@YOUR_CLOUD_NAME
VISION_AI_CLOUDINARY_FOLDER=vision-ai

# Set your public Cloudflare domain in production instead of *.
VISION_AI_CORS_ORIGINS=*
