# Copy this file to backend/.env. Never commit the real .env file.

# Aiven PostgreSQL: copy Service URI, then replace postgres:// with postgresql+psycopg://
VISION_AI_DATABASE_URL=postgresql+psycopg://avnadmin:PASTE_URL_ENCODED_PASSWORD@YOUR_AIVEN_HOST:15522/defaultdb?sslmode=require

# Cloudinary dashboard -> API Keys -> copy the CLOUDINARY_URL value.
VISION_AI_CLOUDINARY_URL=cloudinary://PASTE_API_KEY:PASTE_API_SECRET@YOUR_CLOUD_NAME
VISION_AI_CLOUDINARY_FOLDER=vision-ai

# Set your public Cloudflare domain in production instead of *.
VISION_AI_CORS_ORIGINS=*
VISION_AI_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
VISION_AI_ENVIRONMENT=production
VISION_AI_PUBLIC_APP_URL=https://your-service.onrender.com
VISION_AI_REQUIRE_CLOUDINARY=true

# Recommended on Render Free: HTTPS email API (SMTP ports are blocked).
VISION_AI_RESEND_API_KEY=re_replace_me
VISION_AI_REQUIRE_EMAIL_PROVIDER=true

# Optional SMTP fallback for VPS/local environments.
VISION_AI_SMTP_HOST=smtp.example.com
VISION_AI_SMTP_PORT=587
VISION_AI_SMTP_USERNAME=replace-me
VISION_AI_SMTP_PASSWORD=replace-me
VISION_AI_SMTP_FROM_EMAIL=Vision AI <no-reply@example.com>
VISION_AI_SMTP_STARTTLS=true
VISION_AI_REQUIRE_SMTP=false
VISION_AI_ACCOUNT_TOKEN_MINUTES=30

# Optional cloud enhancement. Keep the key on the backend only.
VISION_AI_GEMINI_API_KEY=AIza_replace_me
VISION_AI_GEMINI_MODEL=gemini-3.5-flash
VISION_AI_GEMINI_TIMEOUT_SECONDS=35
VISION_AI_GEMINI_REQUESTS_PER_HOUR=20

# Resilience limits. Volumetric DDoS still requires an edge/WAF.
VISION_AI_API_TIMEOUT_SECONDS=60
VISION_AI_API_REQUESTS_PER_MINUTE=300
VISION_AI_UPLOAD_REQUESTS_PER_MINUTE=30
